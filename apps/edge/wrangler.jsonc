{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crewstrike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "crewstrike", "database_id": "edff5f7c-99b1-4fdd-a773-22cce135624c", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "BudgetDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetDO"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.2 },
  "vars": {
    "NEURON_CEILING": "9000",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "MOCK_AI": "0",
    "TURNSTILE_SITE_KEY": ""
  }
}
