{
  "name": "crewstrike",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter edge dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck && tsc -p tests/e2e/tsconfig.json --noEmit && tsc -p tools/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "gen:voice": "tsx tools/gen-voice.ts",
    "deploy": "pnpm --filter web build && pnpm --filter edge run migrate:remote && pnpm --filter edge run deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
